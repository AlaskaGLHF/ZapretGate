<ui:FluentWindow x:Class="ZapretGate.Views.AdminRequiredWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Требуются права администратора"
                 Height="280"
                 Width="480"
                 ResizeMode="NoResize"
                 WindowStyle="None"
                 WindowBackdropType="None"
                 Background="#0D0D0D"
                 WindowStartupLocation="CenterScreen">

    <Border Background="#18181B"
            BorderBrush="#27272A"
            BorderThickness="1"
            CornerRadius="12"
            Margin="12"
            Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                <ui:SymbolIcon Symbol="ShieldError24" FontSize="32" Foreground="#F59E0B" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock Text="Требуются права администратора" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#FFFFFF" />
            </StackPanel>
            
            <TextBlock Grid.Row="1"
                       Text="ZapretGate использует драйвер WinDivert для перехвата сетевых пакетов. Без прав администратора запуск обхода и служб невозможен.&#x0a;&#x0a;Нажмите кнопку ниже, чтобы перезапустить приложение с повышенными привилегиями."
                       TextWrapping="Wrap"
                       FontSize="12"
                       LineHeight="18"
                       Foreground="#A1A1AA"
                       VerticalAlignment="Center" />
            
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <ui:Button Content="Выход" 
                           Width="100" 
                           Appearance="Secondary"
                           Margin="0,0,8,0" 
                           Click="BtnExit_Click" />
                <ui:Button Content="Перезапустить от админа" 
                           Appearance="Secondary" 
                           Click="BtnRestart_Click" />
            </StackPanel>
        </Grid>
    </Border>
</ui:FluentWindow>