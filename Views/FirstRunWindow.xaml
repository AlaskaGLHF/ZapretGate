<ui:FluentWindow x:Class="ZapretGate.Views.FirstRunWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Первый запуск — ZapretGate"
                 Height="540"
                 Width="580"
                 ResizeMode="NoResize"
                 WindowStyle="None"
                 WindowBackdropType="None"
                 Background="#0D0D0D"
                 WindowStartupLocation="CenterScreen"
                 MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border Background="#18181B"
            BorderBrush="#27272A"
            BorderThickness="1"
            CornerRadius="14"
            Margin="12"
            Padding="32">
        <Grid>
            <StackPanel x:Name="Step1Panel" VerticalAlignment="Center">
                <Border Width="64" Height="64" CornerRadius="32" Background="#232326" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <ui:SymbolIcon Symbol="FolderOpen24" FontSize="28" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                
                <TextBlock Text="Добро пожаловать в ZapretGate" FontSize="20" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,6" />
                <TextBlock Text="Для начала работы укажите корневой каталог утилиты zapret-discord-youtube." 
                           FontSize="12" 
                           Foreground="#A1A1AA" 
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,0,24" />

                <ui:Button x:Name="BtnBrowseFirstRun"
                           Content="Выбрать папку с Zapret..." 
                           Appearance="Secondary"
                           HorizontalAlignment="Center"
                           Height="38"
                           Padding="20,0"
                           Click="BtnBrowseFirstRun_Click" 
                           Margin="0,0,0,16" />

                <TextBlock x:Name="TxtFirstRunStatus"
                           FontSize="12" 
                           HorizontalAlignment="Center" 
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"
                           Margin="0,0,0,20" />
                
                <ui:Button x:Name="BtnNextStep"
                           Content="Продолжить" 
                           Appearance="Primary"
                           Visibility="Collapsed"
                           HorizontalAlignment="Center"
                           Width="200"
                           Height="38"
                           Click="BtnNextStep_Click" />
            </StackPanel>
            
            <StackPanel x:Name="Step2Panel" VerticalAlignment="Center" Visibility="Collapsed">
                <Border Width="64" Height="64" CornerRadius="32" Background="#232326" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <ui:SymbolIcon Symbol="Rocket24" FontSize="28" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <TextBlock Text="Настройка завершена" FontSize="20" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,6" />
                <TextBlock Text="Каталог успешно подключен. Перед началом работы настоятельно рекомендуется ознакомиться с документацией." 
                           FontSize="12" 
                           Foreground="#A1A1AA" 
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,0,20" />
                
                <Border Background="#0D0D0D" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                    <TextBlock FontSize="12" TextAlignment="Center" Foreground="#E4E4E7" TextWrapping="Wrap">
                        <Run Text="Пожалуйста, перед использованием прочитайте " />
                        <Hyperlink NavigateUri="https://github.com/AlaskaGLHF/ZapretGate#readme" RequestNavigate="Hyperlink_RequestNavigate">
                            <Run Text="README.md" />
                        </Hyperlink>
                        <Run Text=" в репозитории проекта." />
                    </TextBlock>
                </Border>
                
                <ui:Button x:Name="BtnRunTestFirstRun"
                           Content="Подобрать лучшую стратегию"
                           Icon="{ui:SymbolIcon Symbol=Flash24}"
                           Appearance="Secondary"
                           HorizontalAlignment="Stretch"
                           Height="38"
                           Click="BtnRunTestFirstRun_Click"
                           Margin="0,0,0,14" />
                
                <ui:Button x:Name="BtnContinueFirstRun"
                           Content="Перейти в приложение" 
                           Appearance="Primary"
                           HorizontalAlignment="Stretch"
                           Height="38"
                           Click="BtnContinueFirstRun_Click" />
            </StackPanel>
        </Grid>
    </Border>
</ui:FluentWindow>