<ui:FluentWindow x:Class="ZapretGate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:pages="clr-namespace:ZapretGate.Views.Pages"
        Title="ZapretGate" 
        Icon="pack://application:,,,/ZapretGate;component/Resources/app.ico"
        Height="650" 
        Width="800"
        MinHeight="500"
        MinWidth="650"
        WindowBackdropType="None"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        WindowStartupLocation="CenterScreen">

    <ui:FluentWindow.Resources>
        <Style TargetType="ui:NavigationViewItem">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.35" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <ui:TitleBar Title="ZapretGate" Icon="pack://application:,,,/ZapretGate;component/Resources/app.ico" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="105,0,0,0" IsHitTestVisible="False">
                <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="6,1">
                    <TextBlock Text="v1.0" 
                               FontSize="11" 
                               FontWeight="SemiBold" 
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Border>
            </StackPanel>
        </Grid>
        
        <ui:NavigationView x:Name="RootNavigation" 
                           Grid.Row="1" 
                           PaneDisplayMode="Left"
                           IsPaneOpen="False"
                           IsPaneToggleVisible="False"
                           IsBackButtonVisible="Collapsed"
                           Background="Transparent">

            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Главная" 
                                       Icon="{ui:SymbolIcon Symbol=PlayCircle24}" 
                                       TargetPageType="{x:Type pages:DashboardPage}" />
                <ui:NavigationViewItem Content="Сервис" 
                                       Icon="{ui:SymbolIcon Symbol=Wrench24}" 
                                       TargetPageType="{x:Type pages:ServicePage}"
                                       IsEnabled="{Binding MainVm.CanChangeSettings}" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="Настройки" 
                                       Icon="{ui:SymbolIcon Symbol=Settings24}" 
                                       TargetPageType="{x:Type pages:SettingsPage}" />
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>
        
        <ItemsControl x:Name="ToastContainer"
                      Grid.Row="1"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      Margin="0,0,24,24"
                      IsHitTestVisible="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource AccentTextFillColorPrimaryBrush}"
                            BorderThickness="1.5"
                            CornerRadius="8"
                            Padding="14,10"
                            Margin="0,8,0,0"
                            MaxWidth="380">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16"
                                              ShadowDepth="3"
                                              Direction="270"
                                              Opacity="0.35"
                                              Color="#000000" />
                        </Border.Effect>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ContentPresenter Grid.Column="0"
                                              Content="{Binding Icon}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,10,0" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="{Binding Message}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

    </Grid>
</ui:FluentWindow>